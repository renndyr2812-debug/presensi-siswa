 */
function renderAppHtml_() {
  return "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#1e293b\">\n  <meta name=\"mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n  <title>Presensi Siswa Digital \u2014 Cloud Ecosystem</title>\n  \n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js\"></script>\n  <link rel=\"stylesheet\" href=\"css/design-tokens.css\">\n\n  <style>\n    :root {\n      /* Soft, Eye-Comfortable Modern Color System */\n      --color-primary: #2563eb;\n      --color-primary-dark: #1d4ed8;\n      --color-primary-soft: #eff6ff;\n      --color-success: #059669;\n      --color-success-soft: #ecfdf5;\n      --color-warning: #d97706;\n      --color-warning-soft: #fffbeb;\n      --color-danger: #dc2626;\n      --color-danger-soft: #fef2f2;\n      \n      /* Calm Neutrals */\n      --bg-canvas: #f8fafc;\n      --bg-surface: #ffffff;\n      --bg-surface-elevated: #f1f5f9;\n      --text-heading: #0f172a;\n      --text-body: #334155;\n      --text-muted: #64748b;\n      --border-subtle: #e2e8f0;\n      --border-hover: #cbd5e1;\n\n      /* Radii & Shadows */\n      --radius-sm: 10px;\n      --radius-md: 14px;\n      --radius-lg: 20px;\n      --radius-pill: 9999px;\n      --shadow-ambient: 0 10px 25px -4px rgba(15, 23, 42, 0.04), 0 4px 10px -2px rgba(15, 23, 42, 0.02);\n      --shadow-card: 0 12px 32px -4px rgba(15, 23, 42, 0.06), 0 4px 12px -2px rgba(15, 23, 42, 0.03);\n      --shadow-pill: 0 2px 8px rgba(15, 23, 42, 0.08);\n      --shadow-btn: 0 4px 14px rgba(37, 99, 235, 0.22);\n    }\n\n    /* Reset & Typography */\n    *, *::before, *::after {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      -webkit-tap-highlight-color: transparent;\n    }\n\n    body {\n      background-color: var(--bg-canvas);\n      color: var(--text-body);\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n      line-height: 1.5;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    /* \u2500\u2500\u2500 1. Calm Modern Header \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    header {\n      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);\n      color: #ffffff;\n      padding: 18px 16px;\n      text-align: center;\n      position: sticky;\n      top: 0;\n      z-index: 100;\n      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.15);\n    }\n\n    .header-brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 1.25rem;\n      font-weight: 800;\n      letter-spacing: -0.02em;\n    }\n\n    .header-brand-icon {\n      font-size: 1.4rem;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .header-subtext {\n      font-size: 0.8rem;\n      color: #94a3b8;\n      margin-top: 3px;\n      font-weight: 500;\n      letter-spacing: 0.01em;\n    }\n\n    /* \u2500\u2500\u2500 2. Segmented Pill Tab Navigation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .nav-container {\n      display: flex;\n      justify-content: center;\n      padding: 14px 16px;\n      background: var(--bg-canvas);\n      position: sticky;\n      top: 73px;\n      z-index: 90;\n    }\n\n    .segmented-tabs {\n      display: inline-flex;\n      background: #e2e8f0;\n      padding: 4px;\n      border-radius: var(--radius-pill);\n      gap: 4px;\n      max-width: 480px;\n      width: 100%;\n      box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);\n    }\n\n    .tab-btn {\n      flex: 1;\n      padding: 10px 14px;\n      border-radius: var(--radius-pill);\n      border: none;\n      background: transparent;\n      color: var(--text-muted);\n      font-size: 0.88rem;\n      font-weight: 600;\n      cursor: pointer;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 6px;\n      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);\n      white-space: nowrap;\n    }\n\n    .tab-btn.active {\n      background: #ffffff;\n      color: var(--text-heading);\n      font-weight: 700;\n      box-shadow: var(--shadow-pill);\n    }\n\n    .tab-btn:hover:not(.active) {\n      color: var(--text-heading);\n      background: rgba(255, 255, 255, 0.45);\n    }\n\n    /* \u2500\u2500\u2500 3. Content Container & Cards \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .container {\n      max-width: 500px;\n      width: 100%;\n      margin: 0 auto;\n      padding: 0 16px 40px;\n      flex: 1;\n    }\n\n    .tab-content {\n      display: none;\n    }\n\n    .tab-content.active {\n      display: block;\n      animation: tabFadeIn 0.28s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    @keyframes tabFadeIn {\n      from { opacity: 0; transform: translateY(6px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n\n    /* Eye-Comfort Card System */\n    .card {\n      background: var(--bg-surface);\n      border-radius: var(--radius-lg);\n      padding: 24px;\n      border: 1px solid var(--border-subtle);\n      box-shadow: var(--shadow-card);\n      margin-bottom: 16px;\n      transition: border-color 0.2s;\n    }\n\n    .card-title {\n      font-size: 1.1rem;\n      font-weight: 800;\n      color: var(--text-heading);\n      letter-spacing: -0.01em;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin-bottom: 6px;\n    }\n\n    .card-desc {\n      font-size: 0.86rem;\n      color: var(--text-muted);\n      margin-bottom: 18px;\n      line-height: 1.5;\n    }\n\n    /* \u2500\u2500\u2500 4. Install / Download APK Banner \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .install-banner {\n      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);\n      color: #ffffff;\n      padding: 16px 18px;\n      border-radius: var(--radius-md);\n      margin-bottom: 16px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 14px;\n      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n    }\n\n    .install-banner-text strong {\n      font-size: 0.92rem;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .install-banner-text p {\n      font-size: 0.78rem;\n      color: #cbd5e1;\n      margin-top: 3px;\n    }\n\n    .banner-btn-group {\n      display: flex;\n      gap: 8px;\n      flex-shrink: 0;\n    }\n\n    .btn-install {\n      background: #38bdf8;\n      color: #0f172a;\n      padding: 8px 14px;\n      border-radius: var(--radius-sm);\n      font-size: 0.8rem;\n      font-weight: 700;\n      border: none;\n      cursor: pointer;\n      text-decoration: none;\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      transition: all 0.2s;\n    }\n\n    .btn-install:active { transform: scale(0.96); }\n\n    /* \u2500\u2500\u2500 5. Form Elements (Thumb Zone Friendly) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .input-group {\n      margin-bottom: 16px;\n    }\n\n    .input-group label {\n      display: block;\n      font-size: 0.76rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      color: var(--text-muted);\n      margin-bottom: 8px;\n    }\n\n    .input-group input, .input-group select {\n      width: 100%;\n      min-height: 48px;\n      padding: 12px 16px;\n      border-radius: var(--radius-md);\n      border: 1.5px solid var(--border-subtle);\n      background: var(--bg-surface);\n      font-size: 1.05rem;\n      font-weight: 600;\n      color: var(--text-heading);\n      outline: none;\n      transition: all 0.2s ease;\n    }\n\n    .input-group input:focus, .input-group select:focus {\n      border-color: var(--color-primary);\n      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);\n    }\n\n    /* Quick 1-Tap Student Chips */\n    .chips-label {\n      font-size: 0.74rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      color: var(--text-muted);\n      margin-bottom: 8px;\n    }\n\n    .student-chips-group {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      margin-bottom: 18px;\n    }\n\n    .student-chip {\n      background: #f1f5f9;\n      border: 1px solid var(--border-subtle);\n      color: var(--text-body);\n      border-radius: var(--radius-pill);\n      padding: 6px 12px;\n      font-size: 0.8rem;\n      font-weight: 600;\n      cursor: pointer;\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      min-height: 36px;\n      transition: all 0.2s;\n    }\n\n    .student-chip:hover, .student-chip:active {\n      background: var(--color-primary-soft);\n      border-color: var(--color-primary);\n      color: var(--color-primary-dark);\n      transform: translateY(-1px);\n    }\n\n    .chip-avatar {\n      width: 20px;\n      height: 20px;\n      border-radius: 50%;\n      background: var(--color-primary);\n      color: #ffffff;\n      font-size: 0.65rem;\n      font-weight: 800;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Buttons */\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      width: 100%;\n      min-height: 48px;\n      padding: 12px 20px;\n      border-radius: var(--radius-md);\n      background: var(--color-primary);\n      color: #ffffff;\n      font-size: 0.96rem;\n      font-weight: 700;\n      border: none;\n      cursor: pointer;\n      gap: 8px;\n      transition: all 0.2s;\n      box-shadow: var(--shadow-btn);\n      letter-spacing: 0.01em;\n    }\n\n    .btn:active { transform: scale(0.97); }\n    .btn:hover { background: var(--color-primary-dark); }\n    .btn-success { background: var(--color-success); box-shadow: 0 4px 14px rgba(5, 150, 105, 0.22); }\n    .btn-success:hover { background: #047857; }\n    .btn-danger { background: var(--color-danger); }\n    .btn-secondary {\n      background: var(--bg-surface-elevated);\n      color: var(--text-body);\n      border: 1px solid var(--border-subtle);\n      box-shadow: none;\n    }\n    .btn-secondary:hover { background: #e2e8f0; }\n\n    /* \u2500\u2500\u2500 6. Viewfinder & QR Reticle \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    #reader {\n      width: 100%;\n      border-radius: var(--radius-md);\n      overflow: hidden;\n      margin-bottom: 14px;\n      background: #000000;\n      border: 1px solid var(--border-subtle);\n    }\n\n    .qr-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 16px 0;\n    }\n\n    #qrcode {\n      padding: 16px;\n      background: #ffffff;\n      border-radius: var(--radius-lg);\n      box-shadow: var(--shadow-ambient);\n      border: 1px solid var(--border-subtle);\n    }\n\n    #qrcode img, #qrcode canvas {\n      display: block;\n      border-radius: var(--radius-sm);\n    }\n\n    /* Circular SVG Timer Ring */\n    .timer-ring-wrapper {\n      position: relative;\n      width: 72px;\n      height: 72px;\n      margin-top: 16px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .timer-svg {\n      width: 100%;\n      height: 100%;\n      transform: rotate(-90deg);\n    }\n\n    .timer-circle-bg {\n      fill: none;\n      stroke: #e2e8f0;\n      stroke-width: 5;\n    }\n\n    .timer-circle-fg {\n      fill: none;\n      stroke: var(--color-primary);\n      stroke-width: 5;\n      stroke-linecap: round;\n      transition: stroke-dashoffset 1s linear;\n    }\n\n    .timer-text-overlay {\n      position: absolute;\n      font-size: 0.95rem;\n      font-weight: 800;\n      color: var(--color-primary);\n      font-variant-numeric: tabular-nums;\n    }\n\n    /* \u2500\u2500\u2500 7. Status Feedback & Alerts \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .status-box {\n      padding: 14px 16px;\n      border-radius: var(--radius-md);\n      margin-top: 14px;\n      font-size: 0.88rem;\n      font-weight: 600;\n      display: none;\n      line-height: 1.4;\n    }\n\n    .status-success {\n      background: var(--color-success-soft);\n      color: #065f46;\n      border: 1px solid #a7f3d0;\n    }\n\n    .status-error {\n      background: var(--color-danger-soft);\n      color: #991b1b;\n      border: 1px solid #fecaca;\n    }\n\n    .status-info {\n      background: var(--color-primary-soft);\n      color: #1e40af;\n      border: 1px solid #bfdbfe;\n    }\n\n    /* \u2500\u2500\u2500 8. Admin Stat Cards & Table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n    .stat-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 12px;\n      margin-bottom: 16px;\n    }\n\n    .stat-card {\n      background: var(--bg-surface-elevated);\n      padding: 16px 12px;\n      border-radius: var(--radius-md);\n      text-align: center;\n      border: 1px solid var(--border-subtle);\n    }\n\n    .stat-num {\n      font-size: 1.5rem;\n      font-weight: 800;\n      color: var(--color-primary);\n      font-variant-numeric: tabular-nums;\n    }\n\n    .stat-label {\n      font-size: 0.72rem;\n      color: var(--text-muted);\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n      margin-top: 4px;\n    }\n\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 0.84rem;\n    }\n\n    th, td {\n      padding: 12px 10px;\n      text-align: left;\n      border-bottom: 1px solid var(--border-subtle);\n    }\n\n    th {\n      color: var(--text-muted);\n      font-weight: 700;\n      text-transform: uppercase;\n      font-size: 0.72rem;\n      letter-spacing: 0.05em;\n    }\n\n    /* Pill Badges */\n    .badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      padding: 4px 10px;\n      font-size: 0.74rem;\n      font-weight: 700;\n      border-radius: var(--radius-pill);\n      text-transform: uppercase;\n    }\n\n    .badge-success { background: var(--color-success-soft); color: var(--color-success); }\n    .badge-warning { background: var(--color-warning-soft); color: var(--color-warning); }\n    .badge-info { background: var(--color-primary-soft); color: var(--color-primary); }\n\n    /* Student Verified Card */\n    .student-profile-badge {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n      padding: 16px;\n      background: var(--bg-surface-elevated);\n      border-radius: var(--radius-md);\n      border: 1px solid var(--border-subtle);\n      margin-top: 14px;\n    }\n\n    .student-profile-avatar {\n      width: 48px;\n      height: 48px;\n      border-radius: 50%;\n      background: linear-gradient(135deg, #2563eb, #38bdf8);\n      color: #ffffff;\n      font-size: 1.1rem;\n      font-weight: 800;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-shrink: 0;\n    }\n\n    .student-profile-info strong {\n      font-size: 1.05rem;\n      color: var(--text-heading);\n      display: block;\n    }\n\n    .student-profile-info span {\n      font-size: 0.82rem;\n      color: var(--text-muted);\n    }\n  </style>\n</head>\n<body>\n\n  <!-- \u2500\u2500\u2500 1. Header Bar \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <header>\n    <div class=\"header-brand\">\n      <span class=\"header-brand-icon\">\ud83c\udf92</span>\n      <span>Presensi Siswa Digital</span>\n    </div>\n    <div class=\"header-subtext\">Terintegrasi Google Sheets & Google Drive</div>\n  </header>\n\n  <!-- \u2500\u2500\u2500 2. Segmented Pill Tab Bar \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <nav class=\"nav-container\">\n    <div class=\"segmented-tabs\">\n      <button class=\"tab-btn active\" id=\"btn-tab-siswa\" onclick=\"switchTab('tab-siswa')\">\n        <span>\ud83d\udcf1</span> <span>Siswa</span>\n      </button>\n      <button class=\"tab-btn\" id=\"btn-tab-display\" onclick=\"switchTab('tab-display')\">\n        <span>\ud83d\udda5\ufe0f</span> <span>QR Layar</span>\n      </button>\n      <button class=\"tab-btn\" id=\"btn-tab-admin\" onclick=\"switchTab('tab-admin')\">\n        <span>\ud83d\udcca</span> <span>Guru/Admin</span>\n      </button>\n    </div>\n  </nav>\n\n  <!-- \u2500\u2500\u2500 3. Main Container \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <main class=\"container\">\n    \n    <!-- Install PWA & Download APK Banner -->\n    <div id=\"install-banner\" class=\"install-banner\">\n      <div class=\"install-banner-text\">\n        <strong>\ud83d\udcf1 Pasang di Layar HP</strong>\n        <p>Buka seperti aplikasi Android asli tanpa kuota browser!</p>\n      </div>\n      <div class=\"banner-btn-group\">\n        <a href=\"https://drive.google.com/uc?export=download&id=1_EA56xNVH6sQohfmi2U8UUzZk2mGoEbZ\" class=\"btn-install\" target=\"_blank\">\n          \u2b07\ufe0f APK (4 MB)\n        </a>\n        <button class=\"btn-install\" style=\"background: rgba(255,255,255,0.15); color: #fff;\" onclick=\"promptInstall()\">\n          Install\n        </button>\n      </div>\n    </div>\n\n    <!-- \u2500\u2500\u2500 TAB 1: SISWA \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n    <div id=\"tab-siswa\" class=\"tab-content active\">\n      \n      <!-- Card Identitas Siswa -->\n      <div class=\"card\" id=\"student-entry-card\">\n        <div class=\"card-title\">\n          <span>\ud83d\udc64</span> <span>Identitas Siswa</span>\n        </div>\n        <p class=\"card-desc\">\n          Masukkan NIS atau NISN Anda untuk memulai presensi harian\n        </p>\n\n        <!-- Quick 1-Tap Student Chips -->\n        <div class=\"chips-label\">Pilih Akun Demo Cepat:</div>\n        <div class=\"student-chips-group\">\n          <button type=\"button\" class=\"student-chip\" onclick=\"selectDemoNis('1001')\">\n            <span class=\"chip-avatar\">AF</span>\n            <span>1001 \u2022 Ahmad Fauzi</span>\n          </button>\n          <button type=\"button\" class=\"student-chip\" onclick=\"selectDemoNis('1002')\">\n            <span class=\"chip-avatar\">BS</span>\n            <span>1002 \u2022 Budi Santoso</span>\n          </button>\n          <button type=\"button\" class=\"student-chip\" onclick=\"selectDemoNis('1003')\">\n            <span class=\"chip-avatar\">CD</span>\n            <span>1003 \u2022 Citra Dewi</span>\n          </button>\n        </div>\n\n        <div class=\"input-group\">\n          <label for=\"nis-input\">Nomor Induk Siswa (NIS / NISN)</label>\n          <input type=\"text\" id=\"nis-input\" placeholder=\"Contoh: 1001\" autocomplete=\"off\" inputmode=\"numeric\">\n        </div>\n\n        <button class=\"btn\" id=\"btn-check-student\" onclick=\"checkStudent()\">\n          <span id=\"btn-check-text\">Periksa Siswa \u2192</span>\n          <span id=\"btn-check-spinner\" style=\"display: none;\">Memeriksa Database...</span>\n        </button>\n\n        <div id=\"student-error\" class=\"status-box status-error\"></div>\n\n        <!-- Verified Student Info Profile -->\n        <div id=\"student-info\" style=\"display: none;\">\n          <div class=\"student-profile-badge\">\n            <div class=\"student-profile-avatar\" id=\"student-avatar\">AF</div>\n            <div class=\"student-profile-info\" style=\"flex: 1;\">\n              <strong id=\"student-name\">Ahmad Fauzi</strong>\n              <span id=\"student-class\">Kelas: 10-IPA-1</span>\n              <div style=\"margin-top: 4px;\">\n                <span id=\"student-device-badge\" class=\"badge badge-info\">Memeriksa Device...</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Scanner Card (Appears after student verified) -->\n      <div class=\"card\" id=\"scanner-card\" style=\"display: none;\">\n        <div class=\"card-title\">\n          <span>\ud83d\udcf7</span> <span>Scan QR Code Kelas</span>\n        </div>\n        <p class=\"card-desc\">\n          Arahkan kamera ke layar proyektor kelas untuk mencatat kehadiran\n        </p>\n        \n        <div id=\"reader\"></div>\n\n        <div style=\"display: flex; gap: 8px;\">\n          <button class=\"btn btn-secondary\" id=\"camera-btn\" onclick=\"toggleCamera()\">\n            Aktifkan Kamera\n          </button>\n        </div>\n\n        <!-- Manual Token Override Drawer -->\n        <div style=\"margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-subtle);\">\n          <button type=\"button\" class=\"btn btn-secondary\" style=\"font-size: 0.85rem; min-height: 40px;\" onclick=\"toggleManualToken()\">\n            \u2328\ufe0f Input Token Manual (Jika Kamera Bermasalah)\n          </button>\n          \n          <div id=\"manual-token-box\" style=\"display: none; margin-top: 10px;\">\n            <div class=\"input-group\" style=\"margin-bottom: 8px;\">\n              <input type=\"text\" id=\"manual-token-input\" placeholder=\"Ketik token hash dari layar\">\n            </div>\n            <button class=\"btn\" onclick=\"submitManualToken()\">Kirim Presensi</button>\n          </div>\n        </div>\n\n        <div id=\"scan-status\" class=\"status-box\"></div>\n      </div>\n    </div>\n\n    <!-- \u2500\u2500\u2500 TAB 2: QR DISPLAY LAYAR \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n    <div id=\"tab-display\" class=\"tab-content\">\n      <div class=\"card\" style=\"text-align: center;\">\n        <div class=\"card-title\" style=\"justify-content: center;\">\n          <span>\ud83d\udd52</span> <span>QR Code Presensi Dinamis</span>\n        </div>\n        <p class=\"card-desc\" style=\"margin-bottom: 12px;\">\n          QR Code otomatis berganti setiap 10 detik \u2022 Anti-Screenshot & Anti-Jastip\n        </p>\n\n        <!-- Digital Clock -->\n        <div id=\"digital-clock\" style=\"font-size: 2.2rem; font-weight: 800; color: var(--text-heading); font-variant-numeric: tabular-nums; margin-bottom: 12px;\">\n          07:00:00 WIB\n        </div>\n\n        <div class=\"qr-container\">\n          <div id=\"qrcode\"></div>\n          \n          <!-- Circular Countdown Timer Ring -->\n          <div class=\"timer-ring-wrapper\">\n            <svg class=\"timer-svg\" viewBox=\"0 0 72 72\">\n              <circle class=\"timer-circle-bg\" cx=\"36\" cy=\"36\" r=\"30\"></circle>\n              <circle class=\"timer-circle-fg\" id=\"timer-circle\" cx=\"36\" cy=\"36\" r=\"30\" stroke-dasharray=\"188.5\" stroke-dashoffset=\"0\"></circle>\n            </svg>\n            <div class=\"timer-text-overlay\" id=\"qr-timer-text\">10s</div>\n          </div>\n        </div>\n\n        <div style=\"font-size: 0.82rem; color: var(--text-muted); margin-top: 10px;\">\n          \ud83d\udee1\ufe0f Terenkripsi TOTP Server \u2022 Sinkron Langsung ke Google Spreadsheet\n        </div>\n      </div>\n    </div>\n\n    <!-- \u2500\u2500\u2500 TAB 3: ADMIN / GURU \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n    <div id=\"tab-admin\" class=\"tab-content\">\n      \n      <!-- PIN Login Gate -->\n      <div id=\"admin-login-card\" class=\"card\">\n        <div class=\"card-title\">\n          <span>\ud83d\udd12</span> <span>Akses Guru & Tata Usaha</span>\n        </div>\n        <p class=\"card-desc\">\n          Masukkan PIN keamanan untuk melihat data kehadiran dan statistik\n        </p>\n        <div class=\"input-group\">\n          <label for=\"admin-pin\">PIN Guru</label>\n          <input type=\"password\" id=\"admin-pin\" placeholder=\"Default: 123456\" value=\"123456\">\n        </div>\n        <button class=\"btn\" onclick=\"loginAdmin()\">Buka Dashboard Admin \u2192</button>\n      </div>\n\n      <!-- Authenticated Admin Panel -->\n      <div id=\"admin-panel\" style=\"display: none;\">\n        \n        <!-- Live Stat Counters -->\n        <div class=\"card\">\n          <div class=\"card-title\">\n            <span>\ud83d\udcc8</span> <span>Rekap Kehadiran Hari Ini</span>\n          </div>\n          <div class=\"stat-grid\">\n            <div class=\"stat-card\">\n              <div class=\"stat-num\" id=\"stat-total\">0</div>\n              <div class=\"stat-label\">Total Hadir</div>\n            </div>\n            <div class=\"stat-card\">\n              <div class=\"stat-num\" id=\"stat-ontime\" style=\"color: var(--color-success);\">0</div>\n              <div class=\"stat-label\">Tepat Waktu</div>\n            </div>\n            <div class=\"stat-card\">\n              <div class=\"stat-num\" id=\"stat-late\" style=\"color: var(--color-warning);\">0</div>\n              <div class=\"stat-label\">Terlambat</div>\n            </div>\n          </div>\n          \n          <button class=\"btn btn-success\" onclick=\"refreshAdmin()\">\n            \ud83d\udd04 Segarkan Rekap Data\n          </button>\n        </div>\n\n        <!-- Attendance Roster Table -->\n        <div class=\"card\">\n          <div class=\"card-title\" style=\"justify-content: space-between; flex-wrap: wrap;\">\n            <span>\ud83d\udc65 Daftar Hadir Siswa</span>\n          </div>\n\n          <div style=\"overflow-x: auto; margin-top: 12px;\">\n            <table id=\"attendance-table\">\n              <thead>\n                <tr>\n                  <th>Waktu</th>\n                  <th>Nama Siswa</th>\n                  <th>Kelas</th>\n                  <th>Status</th>\n                </tr>\n              </thead>\n              <tbody id=\"attendance-tbody\">\n                <tr><td colspan=\"4\" style=\"text-align:center; color: var(--text-muted);\">Memuat data presensi...</td></tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n  </main>\n\n  <script src=\"js/config.js\"></script>\n  <script src=\"js/audio-haptics.js\"></script>\n\n  <!-- \u2500\u2500\u2500 4. Client Scripts \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\n  <script>\n    // Live Digital Clock\n    function updateClock() {\n      const el = document.getElementById('digital-clock');\n      if (el) {\n        const now = new Date();\n        const h = String(now.getHours()).padStart(2, '0');\n        const m = String(now.getMinutes()).padStart(2, '0');\n        const s = String(now.getSeconds()).padStart(2, '0');\n        el.textContent = `${h}:${m}:${s} WIB`;\n      }\n    }\n    setInterval(updateClock, 1000);\n    updateClock();\n\n    // Tab Switcher\n    function switchTab(tabId) {\n      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n      \n      const btnMap = {\n        'tab-siswa': 'btn-tab-siswa',\n        'tab-display': 'btn-tab-display',\n        'tab-admin': 'btn-tab-admin'\n      };\n      \n      const activeBtn = document.getElementById(btnMap[tabId]);\n      if (activeBtn) activeBtn.classList.add('active');\n      \n      const activeContent = document.getElementById(tabId);\n      if (activeContent) activeContent.classList.add('active');\n\n      if (tabId === 'tab-display') startDisplayLoop();\n      else stopDisplayLoop();\n    }\n\n    // Quick Student Chip Selection\n    function selectDemoNis(nis) {\n      const input = document.getElementById('nis-input');\n      if (input) {\n        input.value = nis;\n        checkStudent();\n      }\n    }\n\n    function toggleManualToken() {\n      const box = document.getElementById('manual-token-box');\n      if (box) {\n        box.style.display = (box.style.display === 'none') ? 'block' : 'none';\n      }\n    }\n\n    // Device Fingerprint\n    function getDeviceId() {\n      let id = localStorage.getItem('app_device_id');\n      if (!id) {\n        id = 'dev_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now().toString(36);\n        localStorage.setItem('app_device_id', id);\n      }\n      return id;\n    }\n\n    // API Caller via window.API.apiFetch\n    async function callApi(params) {\n      if (window.API && window.API.apiFetch) {\n        return window.API.apiFetch(params);\n      }\n      const url = new URL('https://script.google.com/macros/s/AKfycbzD9_wb8KusYc4TLzlaoTAijO6oXtelTqMZic5aqnsbAO2pIIxfXsL1nOFPj1WwDJhpjA/exec');\n      Object.entries(params).forEach(([k, v]) => {\n        if (v !== undefined && v !== null) url.searchParams.set(k, String(v));\n      });\n      url.searchParams.set('_t', Date.now());\n      const res = await fetch(url.toString(), { method: 'GET', cache: 'no-store' });\n      return res.json();\n    }\n\n    // \u2500\u2500\u2500 SISWA CONTROLLER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    let currentStudent = null;\n    let html5QrCode = null;\n\n    function getInitials(name) {\n      if (!name) return 'ST';\n      const parts = name.trim().split(/\\s+/);\n      if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();\n      return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n    }\n\n    async function checkStudent() {\n      const nisInput = document.getElementById('nis-input');\n      const errBox = document.getElementById('student-error');\n      const btnText = document.getElementById('btn-check-text');\n      const btnSpinner = document.getElementById('btn-check-spinner');\n      const btnCheck = document.getElementById('btn-check-student');\n\n      errBox.style.display = 'none';\n      const nis = nisInput.value.trim();\n      if (!nis) {\n        errBox.textContent = 'Masukkan NIS atau NISN siswa!';\n        errBox.style.display = 'block';\n        return;\n      }\n\n      btnCheck.disabled = true;\n      btnText.style.display = 'none';\n      btnSpinner.style.display = 'inline';\n\n      try {\n        const res = await callApi({ action: 'lookupStudent', nisn: nis, nis: nis });\n        const student = res.student || res;\n\n        if (res.error || !student || !student.name) {\n          throw new Error(res.error || ('Siswa dengan NIS ' + nis + ' tidak ditemukan di Google Sheets!'));\n        }\n\n        currentStudent = student;\n        document.getElementById('student-name').textContent = currentStudent.name;\n        document.getElementById('student-class').textContent = 'Kelas: ' + (currentStudent.class_name || currentStudent.class || '-');\n        document.getElementById('student-avatar').textContent = getInitials(currentStudent.name);\n        \n        const myDev = getDeviceId();\n        const badge = document.getElementById('student-device-badge');\n        \n        if (!currentStudent.is_device_bound && !currentStudent.deviceId) {\n          badge.textContent = 'HP Baru (Otomatis Dikaitkan)';\n          badge.className = 'badge badge-warning';\n        } else {\n          badge.textContent = 'HP Terverifikasi Aman \u2705';\n          badge.className = 'badge badge-success';\n        }\n\n        document.getElementById('student-info').style.display = 'block';\n        document.getElementById('scanner-card').style.display = 'block';\n        \n        // Auto scroll smoothly to scanner\n        document.getElementById('scanner-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n      } catch (err) {\n        errBox.textContent = '\u274c ' + err.message;\n        errBox.style.display = 'block';\n      } finally {\n        btnCheck.disabled = false;\n        btnText.style.display = 'inline';\n        btnSpinner.style.display = 'none';\n      }\n    }\n\n    function toggleCamera() {\n      const btn = document.getElementById('camera-btn');\n      if (html5QrCode && html5QrCode.isScanning) {\n        html5QrCode.stop().then(() => {\n          btn.textContent = 'Aktifkan Kamera';\n          btn.className = 'btn btn-secondary';\n        });\n      } else {\n        html5QrCode = new Html5Qrcode(\"reader\");\n        html5QrCode.start(\n          { facingMode: \"environment\" },\n          { fps: 12, qrbox: { width: 220, height: 220 } },\n          onScanSuccess,\n          () => {}\n        ).then(() => {\n          btn.textContent = 'Matikan Kamera';\n          btn.className = 'btn btn-danger';\n        }).catch(err => {\n          alert('Izin kamera diperlukan untuk memindai: ' + err);\n        });\n      }\n    }\n\n    async function onScanSuccess(decodedText) {\n      if (html5QrCode && html5QrCode.isScanning) {\n        html5QrCode.stop();\n        document.getElementById('camera-btn').textContent = 'Aktifkan Kamera';\n        document.getElementById('camera-btn').className = 'btn btn-secondary';\n      }\n\n      let token = decodedText;\n      try {\n        const parsed = JSON.parse(decodedText);\n        if (parsed.token) token = parsed.token;\n      } catch (_) {}\n\n      await submitTokenAttendance(token);\n    }\n\n    async function submitManualToken() {\n      const input = document.getElementById('manual-token-input');\n      const token = input.value.trim();\n      if (!token) return alert('Masukkan token dari layar!');\n      await submitTokenAttendance(token);\n    }\n\n    async function submitTokenAttendance(token) {\n      const statusBox = document.getElementById('scan-status');\n      statusBox.className = 'status-box status-info';\n      statusBox.textContent = 'Memvalidasi kehadiran & sinkronisasi Google Sheets...';\n      statusBox.style.display = 'block';\n\n      try {\n        const res = await callApi({\n          action: 'scan',\n          studentId: currentStudent.id,\n          token: token,\n          deviceCredentialId: getDeviceId()\n        });\n\n        if (res.error) throw new Error(res.error);\n\n        statusBox.className = 'status-box status-success';\n        statusBox.innerHTML = '\ud83c\udf89 <strong>Presensi Berhasil Tercatat!</strong><br>Status: ' + (res.attendance ? res.attendance.status : 'HADIR') + ' \u2022 Waktu: ' + (res.attendance ? res.attendance.time : '') + ' WIB';\n      } catch (err) {\n        statusBox.className = 'status-box status-error';\n        statusBox.textContent = '\u274c Gagal: ' + err.message;\n      }\n    }\n\n    // \u2500\u2500\u2500 TAB 2: DISPLAY CONTROLLER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    let displayTimer = null;\n    let qrGenerator = null;\n    let countdownInterval = null;\n\n    function startDisplayLoop() {\n      stopDisplayLoop();\n      refreshDisplayQR();\n      displayTimer = setInterval(refreshDisplayQR, 10000);\n    }\n\n    function stopDisplayLoop() {\n      if (displayTimer) clearInterval(displayTimer);\n      if (countdownInterval) clearInterval(countdownInterval);\n      displayTimer = null;\n      countdownInterval = null;\n    }\n\n    async function refreshDisplayQR() {\n      try {\n        const data = await callApi({ action: 'getQR' });\n        if (!data || !data.token) return;\n\n        const qrContainer = document.getElementById('qrcode');\n        qrContainer.innerHTML = '';\n        qrGenerator = new QRCode(qrContainer, {\n          text: data.rawPayload || data.token,\n          width: 210,\n          height: 210,\n          colorDark: \"#0f172a\",\n          colorLight: \"#ffffff\",\n          correctLevel: QRCode.CorrectLevel.M\n        });\n\n        startCountdown(data.expiresIn || 10, data.intervalSeconds || 10);\n      } catch (e) {\n        console.warn('QR Refresh error:', e);\n      }\n    }\n\n    function startCountdown(seconds, total) {\n      if (countdownInterval) clearInterval(countdownInterval);\n      let rem = seconds;\n      const circle = document.getElementById('timer-circle');\n      const text = document.getElementById('qr-timer-text');\n      const totalCircumference = 188.5; // 2 * PI * 30\n\n      function update() {\n        if (text) text.textContent = rem + 's';\n        if (circle) {\n          const progress = (total - rem) / total;\n          circle.style.strokeDashoffset = totalCircumference * progress;\n        }\n        if (rem <= 0) {\n          clearInterval(countdownInterval);\n        } else {\n          rem--;\n        }\n      }\n      update();\n      countdownInterval = setInterval(update, 1000);\n    }\n\n    // \u2500\u2500\u2500 TAB 3: ADMIN CONTROLLER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    async function loginAdmin() {\n      const pin = document.getElementById('admin-pin').value;\n      if (pin !== '123456') {\n        alert('PIN salah! Hubungi administrator.');\n        return;\n      }\n      document.getElementById('admin-login-card').style.display = 'none';\n      document.getElementById('admin-panel').style.display = 'block';\n      await refreshAdmin();\n    }\n\n    async function refreshAdmin() {\n      try {\n        const data = await callApi({ action: 'adminOverview', pin: '123456' });\n        if (data.error) throw new Error(data.error);\n\n        document.getElementById('stat-total').textContent = data.stats.totalPresent || 0;\n        document.getElementById('stat-ontime').textContent = data.stats.onTime || 0;\n        document.getElementById('stat-late').textContent = data.stats.late || 0;\n\n        const tbody = document.getElementById('attendance-tbody');\n        if (data.records && data.records.length > 0) {\n          tbody.innerHTML = data.records.map(r => `\n            <tr>\n              <td style=\"font-weight: 700; font-variant-numeric: tabular-nums;\">${r.time || '-'}</td>\n              <td>${r.student_name || '-'}</td>\n              <td><span style=\"color: var(--text-muted);\">${r.class_name || '-'}</span></td>\n              <td>\n                <span class=\"badge ${r.status === 'TERLAMBAT' ? 'badge-warning' : 'badge-success'}\">\n                  ${r.status || 'HADIR'}\n                </span>\n              </td>\n            </tr>\n          `).join('');\n        } else {\n          tbody.innerHTML = '<tr><td colspan=\"4\" style=\"text-align:center; color: var(--text-muted); padding: 18px;\">Belum ada data presensi hari ini</td></tr>';\n        }\n      } catch (err) {\n        console.warn('Admin fetch error:', err);\n      }\n    }\n\n    // PWA Install Prompt\n    let deferredPrompt = null;\n    window.addEventListener('beforeinstallprompt', (e) => {\n      e.preventDefault();\n      deferredPrompt = e;\n      const banner = document.getElementById('install-banner');\n      if (banner) banner.style.display = 'flex';\n    });\n\n    function promptInstall() {\n      if (deferredPrompt) {\n        deferredPrompt.prompt();\n        deferredPrompt.userChoice.then((choice) => {\n          if (choice.outcome === 'accepted') {\n            document.getElementById('install-banner').style.display = 'none';\n          }\n          deferredPrompt = null;\n        });\n      } else {\n        alert('Untuk menginstall: Buka menu browser Anda (titik 3 di kanan atas) lalu pilih \"Tambahkan ke Layar Utama\" / \"Install App\".');\n      }\n    }\n  </script>\n</body>\n</html>\n";
}
